# ==============================================================
# CONFIGURACIONES DE ENTORNO - TandemPRO Backend
# ==============================================================

# Puerto en el que correrá el servidor Backend
PORT="7850"

# Clave de la API de Gemini (necesaria para el módulo de optimización de IA)
GEMINI_API_KEY="AQUI_TU_CLAVE_DE_GEMINI"

# ==============================================================
# Credenciales de SAP Service Layer y HANA:
# ==============================================================
SAP_SERVICE_LAYER_URL="https://172.19.0.88:50000/b1s/v1"
HANA_SERVER="172.19.0.88:30015"
HANA_USER="SYSTEM"
HANA_PASSWORD="Admin123"

# Si está en "true", las operaciones a SAP serán simuladas (sin afectar la DB real)
# Si está en "false", se realizarán consultas e inserciones reales.
IS_SANDBOX="false"
